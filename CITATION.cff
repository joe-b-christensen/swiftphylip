cff-version: 1.2.0
message: "If you use swiftphylip, please cite it as below, and also cite vcf2phylip, whose behaviour it reproduces."
title: "swiftphylip: a byte-identical drop-in replacement for vcf2phylip"
type: software
version: 1.0.0
date-released: 2026-11-05
license: GPL-3.0-only
repository-code: "https://github.com/joe-b-christensen/swiftphylip"
authors:
  - family-names: Christensen
    given-names: Joe
    orcid: "https://orcid.org/0009-0007-0908-1299"
    email: joechristensen@clin.au.dk
    affiliation: "Translational Neuropsychiatry Unit (TNU), Department of Clinical Medicine, Aarhus University, Denmark"
keywords:
  - vcf2phylip
  - VCF
  - PHYLIP
  - NEXUS
  - phylogenetics
  - performance
abstract: >-
  swiftphylip converts a VCF into the same PHYLIP, FASTA, NEXUS and binary NEXUS files as vcf2phylip 2.9, with the same messages
  and exit status. On six real data sets on an AVX2 laptop it was 12- to 706-fold faster than vcf2phylip. plink2 wrote the same
  PHYLIP bytes on six real sets, and swiftphylip was 2.5- to 5-fold faster than plink2 on those sets.
references:
  - type: software
    title: "vcf2phylip"
    authors:
      - family-names: Ortiz
        given-names: Edgardo M.
    version: "2.9"
    doi: "10.5281/zenodo.2540861"
    repository-code: "https://github.com/edgardomortiz/vcf2phylip"
